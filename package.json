{
  "name": "pixel-fighter-desktop-build",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated desktop packaging for the original Pixel Fighter game",
  "scripts": {
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:dev": "npm run desktop:prepare && electron output/desktop/app",
    "desktop:test": "node --test desktop/tests/*.test.cjs",
    "desktop:regression": "node desktop/regression.cjs",
    "desktop:build:win": "node desktop/build.cjs win",
    "desktop:build:mac": "node desktop/build.cjs mac",
    "desktop:verify": "node desktop/verify.cjs"
  },
  "devDependencies": {
    "@electron/asar": "4.0.1",
    "@napi-rs/canvas": "0.1.80",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "terser": "5.51.2"
  }
}
